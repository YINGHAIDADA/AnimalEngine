// Windows resources of the game executable: icon and version information (M7).
#include <winver.h>

1 ICON "@ANIMAL_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@ANIMAL_COMPANY@"
            VALUE "FileDescription", "@ANIMAL_PRODUCT_NAME@"
            VALUE "FileVersion", "@ANIMAL_VERSION@"
            VALUE "InternalName", "AnimalGame"
            VALUE "LegalCopyright", "@ANIMAL_COPYRIGHT@"
            VALUE "OriginalFilename", "AnimalGame.exe"
            VALUE "ProductName", "@ANIMAL_PRODUCT_NAME@"
            VALUE "ProductVersion", "@ANIMAL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
